# Supabase project (Auth-only MVP). Copy to `.env` and fill in.
# EXPO_PUBLIC_* vars are inlined into the client bundle — the anon key is
# meant to be public; protect data with row-level security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: without Supabase config the login flow runs in mock mode so the
# loading / error states stay demoable. Controls the simulated outcome.
# One of: success | cancelled | network | failed  (default: network)
EXPO_PUBLIC_MOCK_OUTCOME=network
